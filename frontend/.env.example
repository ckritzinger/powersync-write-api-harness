# Frontend (Express + Vue). Copy to .env.

# The Rails app in backend/ (token issuing, signing key, test users). Default: http://localhost:3000
# BACKEND_URL=http://localhost:3000

# Write API under test (powersync-reference-write-implementation backend). Called by this app's server, which proxies the
# reference connector's POST /api/data to it.
WRITE_API_URL=http://localhost:6060
# Your hosted PowerSync instance endpoint. Called from the browser.
POWERSYNC_URL=https://<instance-id>.powersync.journeyapps.com

# Token issuer/audience are configured in backend/.env (JWT_ISSUER, JWT_AUDIENCE), because that is
# where the tokens are signed. The signing key lives in ../keys/.

# Optional
# PORT=5180
# PUBLIC_ORIGIN=http://localhost:5180   # origin the browser uses for this server (VITE_BACKEND_URL)
