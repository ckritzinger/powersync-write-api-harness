{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext.AsyncIterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // src/example-client is a symlink into powersync-reference-write-implementation, which has no node_modules: resolve its
    // bare imports from this app instead.
    "paths": {
      "@powersync/web": ["./node_modules/@powersync/web"],
      "openapi-fetch": ["./node_modules/openapi-fetch"],
      "uuid": ["./node_modules/uuid"]
    },
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  // Reference copy-paste variant, not used by the harness.
  "exclude": ["src/example-client/PowersyncConnector.singlefile.ts"]
}
