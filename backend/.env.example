# Same values as the write API under test (powersync-reference-write-implementation .env) — switch them in lockstep.
DATABASE_TYPE=postgres
# From: terraform -chdir=../infra output -raw database_uri
DATABASE_URI=postgres://harness:<password>@<rds-endpoint>:5432/harness

# Optional overrides when the write API's URI is not usable as-is:
# DATABASE_URL=postgresql://...      (ActiveRecord; adapter scheme postgresql | mysql2 | sqlserver)
# MONGODB_URI=mongodb+srv://...      (Mongoid)
# PORT=3000

# Test tokens (signed by this app; see ../keys/README.md). The audience must be accepted by the
# PowerSync instance and the write API; it defaults to POWERSYNC_URL, which PowerSync always accepts.
POWERSYNC_URL=https://<instance-id>.powersync.journeyapps.com
# JWT_AUDIENCE=
JWT_ISSUER=write-api-harness
# TOKEN_TTL_SECONDS=3600
